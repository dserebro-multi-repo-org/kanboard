{#- Port of app/Template/project_header/views.php. Variables: project, filters -#}
<ul class="views">
    
    {{ helper.hook.render('template:project-header:view-switcher-before-project-overview', {'project': project, 'filters': filters}) }}

    <li {{ helper.app.checkMenuSelection('ProjectOverviewController') }}>
        {{ helper.url.icon('eye', t('Overview'), 'ProjectOverviewController', 'show', {'project_id': project.id, 'search': filters.search}, false, 'view-overview', t('Keyboard shortcut: "%s"', 'v o')) }}
    </li>

    {{ helper.hook.render('template:project-header:view-switcher-before-board-view', {'project': project, 'filters': filters}) }}

    <li {{ helper.app.checkMenuSelection('BoardViewController') }}>
        {{ helper.url.icon('th', t('Board'), 'BoardViewController', 'show', {'project_id': project.id, 'search': filters.search}, false, 'view-board', t('Keyboard shortcut: "%s"', 'v b')) }}
    </li>

    {{ helper.hook.render('template:project-header:view-switcher-before-task-list', {'project': project, 'filters': filters}) }}

    <li {{ helper.app.checkMenuSelection('TaskListController') }}>
        {{ helper.url.icon('list', t('List'), 'TaskListController', 'show', {'project_id': project.id, 'search': filters.search}, false, 'view-listing', t('Keyboard shortcut: "%s"', 'v l')) }}
    </li>

    {{ helper.hook.render('template:project-header:view-switcher', {'project': project, 'filters': filters}) }}
</ul>
