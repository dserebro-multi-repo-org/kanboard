{#-
  Port of app/Template/dashboard/subtasks.php.
  Variables: user, nb_subtasks, paginator (object with getCollection(), order(label, column) returning safe HTML,
  and toString() returning the pagination HTML, echoed as safe HTML)
  Included partials receive the loop variable `task` and `user_id` (PHP passes it to task_list/task_subtasks only).
-#}
<div class="page-header">
    <h2>{{ helper.url.link(t('My subtasks'), 'DashboardController', 'subtasks', {'user_id': user.id}) }} ({{ nb_subtasks }})</h2>
</div>
{% if nb_subtasks == 0 %}
    <p class="alert">{{ t('There is nothing assigned to you.') }}</p>
{% else %}
    <div class="table-list">
        <div class="table-list-header">
            <div class="table-list-header-count">
                {% if nb_subtasks > 1 %}
                    {{ t('%d subtasks', nb_subtasks) }}
                {% else %}
                    {{ t('%d subtask', nb_subtasks) }}
                {% endif %}
            </div>
            <div class="table-list-header-menu">
                <div class="dropdown">
                    <a href="#" class="dropdown-menu dropdown-menu-link-icon"><strong>{{ t('Sort') }} <i class="fa fa-caret-down"></i></strong></a>
                    <ul>
                        <li>
                            {{ paginator.order(t('Task ID'), 'tasks.id') | safe }}
                        </li>
                        <li>
                            {{ paginator.order(t('Title'), 'tasks.title') | safe }}
                        </li>
                        <li>
                            {{ paginator.order(t('Priority'), 'tasks.priority') | safe }}
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        {% for task in paginator.getCollection() %}
            <div class="table-list-row color-{{ helper.text.e(task.color_id) }}">
                {% include "task_list/task_title" %}

                {% set user_id = user.id %}
                {% include "task_list/task_subtasks" %}
                {% set user_id = null %}
            </div>
        {% endfor %}
    </div>

    {{ paginator | safe }}
{% endif %}
