{#- Port of app/Template/dashboard/sidebar.php. Variables: user -#}
<div class="sidebar">
    <ul>
        <li {{ helper.app.checkMenuSelection('DashboardController', 'show') }}>
            {{ helper.url.link(t('Overview'), 'DashboardController', 'show', {'user_id': user.id}) }}
        </li>
        <li {{ helper.app.checkMenuSelection('DashboardController', 'projects') }}>
