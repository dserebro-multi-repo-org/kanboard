{#
  Variables: events (array of event rows, each with creator_id, author_username, author_name, email,
  avatar_path and event_content), avatar (imported avatar macro)
  event.event_content is pre-rendered HTML of the per-type event template (output with | safe).
  No async helper results are needed (see src/views/prepare/event.ts).
#}
{% if not events or events | length == 0 %}
    <p class="alert">{{ t('There is no activity yet.') }}</p>
{% else %}
    {% for event in events %}
        <div class="activity-event">
            {{ avatar.render(
                event.creator_id,
                event.author_username,
                event.author_name,
                event.email,
                event.avatar_path
            ) }}

            <div class="activity-content">
                {{ event.event_content | safe }}
            </div>
        </div>
    {% endfor %}
{% endif %}
