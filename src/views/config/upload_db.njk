{#- Port of app/Template/config/upload_db.php -#}
<div class="page-header">
    <h2>{{ t('Upload the database') }}</h2>
</div>

<div class="alert">
    <p>
        {{ t('You could upload the previously downloaded Sqlite database (Gzip format).') }}
    </p>
</div>

<form action="{{ helper.url.href('ConfigController', 'saveUploadedDb', {}, true) }}" method="post" enctype="multipart/form-data">
    {{ helper.form.label(t('Database file'), 'file') }}
    {{ helper.form.file('file') }}

    {{ helper.modal.submitButtons({'submitLabel': t('Upload')}) }}
</form>
