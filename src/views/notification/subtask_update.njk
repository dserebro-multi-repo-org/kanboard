{# Notification template. Pre-resolved variable (see prepareNotificationVars in views/prepare/notification.ts): application_url. #}
<html>
<body>
<h2>{{ task.title }} (#{{ task.id }})</h2>

<h3>{{ t('Sub-task updated') }}</h3>

<ul>
    <li>{{ t('Title:') }} {{ subtask.title }}</li>
    <li>{{ t('Status:') }} {{ t(subtask.status_name) }}</li>
    <li>{{ t('Assignee:') }} {{ subtask.name or subtask.username or '?' }}</li>
    {% if subtask.time_spent or subtask.time_estimated %}
    <li>
        {{ t('Time tracking:') }}
        {% if subtask.time_spent %}
            {{ t('%sh spent', n(subtask.time_spent)) }}
        {% endif %}
        {% if subtask.time_spent and subtask.time_estimated %}/{% endif %}
        {% if subtask.time_estimated %}
            {{ t('%sh estimated', n(subtask.time_estimated)) }}
        {% endif %}
    </li>
    {% endif %}
</ul>

{% include "notification/footer" %}
</body>
</html>
