{# Notification template. Pre-resolved variable (see prepareNotificationVars in views/prepare/notification.ts): application_url. #}
<html>
<body>
<h2>{{ task.title }} (#{{ task.id }})</h2>

{# Also pre-resolved (async helper dt.datetime): date_creation_formatted, date_due_formatted. See prepareTaskCreateNotificationVars. #}
<ul>
    <li>
        {{ t('Created:') }} {{ date_creation_formatted }}
    </li>
    {% if task.date_due %}
    <li>
        <strong>{{ t('Due date:') }} {{ date_due_formatted }}</strong>
    </li>
    {% endif %}
    {% if task.creator_username %}
    <li>
        {{ t('Created by %s', task.creator_name or task.creator_username) }}
    </li>
    {% endif %}
    <li>
        <strong>
        {% if task.assignee_username %}
            {{ t('Assigned to %s', task.assignee_name or task.assignee_username) }}
        {% else %}
            {{ t('There is nobody assigned') }}
        {% endif %}
        </strong>
    </li>
    <li>
        {{ t('Column on the board:') }}
        <strong>{{ task.column_title }}</strong>
    </li>
    <li>{{ t('Task position:') }} {{ task.position }}</li>
    {% if task.category_name %}
    <li>
        {{ t('Category:') }} <strong>{{ task.category_name }}</strong>
    </li>
    {% endif %}
</ul>

{% if task.description %}
    <h2>{{ t('Description') }}</h2>
    {{ helper.text.markdown(task.description, true) | safe }}
{% endif %}

{% include "notification/footer" %}
</body>
</html>
