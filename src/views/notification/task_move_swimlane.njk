{# Notification template. Pre-resolved variable (see prepareNotificationVars in views/prepare/notification.ts): application_url. #}
<html>
<body>
<h2>{{ task.title }} (#{{ task.id }})</h2>

<ul>
    <li>
        {% if task.swimlane_id == 0 %}
            {{ t('The task has been moved to the first swimlane') }}
        {% else %}
            {{ t('The task has been moved to another swimlane:') }}
            <strong>{{ task.swimlane_name }}</strong>
        {% endif %}
    </li>
    <li>
        {{ t('Column on the board:') }}
        <strong>{{ task.column_title }}</strong>
    </li>
    <li>{{ t('Task position:') }} {{ task.position }}</li>
</ul>

{% include "notification/footer" %}
</body>
</html>
