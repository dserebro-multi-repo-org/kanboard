{# Variables: is_ajax, title, project, sidebar_template, content_for_sublayout (HTML),
   project_header (HTML, only when not is_ajax: pre-resolved async projectHeader.render(project, 'TaskListController', 'show'),
   see prepareAnalyticLayoutVars in views/prepare/analytic.ts). #}
{% if is_ajax %}
    <div class="page-header">
        <h2>{{ title }}</h2>
    </div>
{% else %}
    {{ project_header | safe }}
{% endif %}
<section class="sidebar-container">
    {% include sidebar_template %}

    <div class="sidebar-content">
        {{ content_for_sublayout | safe }}
    </div>
</section>
