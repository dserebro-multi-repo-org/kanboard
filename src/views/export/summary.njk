{# Variables: project, title, values (form values: project_id, from, to, bom) #}
{% set values = values if values is defined else {} %}
{% include "export/header" %}

<p class="alert alert-info">{{ t('This export contains the number of tasks per column grouped per day.') }}</p>

<form class="js-modal-ignore-form" method="post" action="{{ url.href('ExportController', 'summary', {project_id: project.id}) }}" autocomplete="off">
    {{ form.csrf() }}
    {{ form.hidden('project_id', values) }}
    {{ form.date(t('Start date'), 'from', values) }}
    {{ form.date(t('End date'), 'to', values) }}
    {{ form.checkbox('bom', t('Add a BOM at the beginning of the file (required for Microsoft Excel)'), 1, values.bom is defined and values.bom == 1) }}

    <div class="form-actions">
        <button type="submit" class="btn btn-blue js-form-export">{{ t('Export') }}</button>
        {{ t('or') }}
        {{ url.link(t('cancel'), 'ExportController', 'summary', {project_id: project.id}, false, 'js-modal-close') }}
    </div>
</form>
